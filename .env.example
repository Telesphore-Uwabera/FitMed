# Copy to .env.local for local development. Never commit real secrets.

# MongoDB Atlas — Cluster0, database FitMed
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/FitMed?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=FitMed

# Cloudinary (Dashboard → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo (app.brevo.com → SMTP & API → API Keys)
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=fitmedrwanda@gmail.com
BREVO_SENDER_NAME=FitMed Rwanda

# Signed httpOnly session cookie
SESSION_SECRET=change-this-to-a-long-random-string

# Public URLs (set to your Render URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
